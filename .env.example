# Copiar a .env y completar. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=3000

# Conexión de la API: usuario panema_app (sin privilegios → aplica RLS)
DATABASE_URL=postgres://panema_app:cambiar-app@localhost:5432/panema
# Conexión para migraciones: usuario dueño de las tablas
DATABASE_URL_MIGRACIONES=postgres://panema:cambiar-dueno@localhost:5432/panema
# Solo docker-compose.yml (producción): contraseña del usuario dueño de Postgres
DB_OWNER_PASSWORD=cambiar-dueno
# Contraseña que el script de migración le asigna a panema_app
APP_DB_PASSWORD=cambiar-app

# Mínimo 32 caracteres aleatorios: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-verdad

# Origen del front (Vercel). Varios separados por coma.
CORS_ORIGIN=http://localhost:5173
# En producción: .tudominio.cl (para que app. y api. compartan la cookie)
COOKIE_DOMAIN=

UPLOADS_DIR=./uploads
