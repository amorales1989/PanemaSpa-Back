# Reemplazar por el dominio real. Caddy saca y renueva el certificado solo.
api.tudominio.cl {
	encode zstd gzip

	# Fotos de productos servidas directo desde el volumen
	handle_path /uploads/* {
		root * /srv/uploads
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle {
		reverse_proxy api:3000
	}
}
